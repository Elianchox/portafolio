---
interface Props {
  id?: string
  class?: string
}

const id = Astro.props.id
const className = Astro.props.class
---
<svg id={id} class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
  <line class="hamburger-line-top" stroke-linecap="round" stroke-width="2" x1="4" y1="6" x2="20" y2="6" />
  <line class="hamburger-line-mid" stroke-linecap="round" stroke-width="2" x1="4" y1="12" x2="20" y2="12" />
  <line class="hamburger-line-bot" stroke-linecap="round" stroke-width="2" x1="4" y1="18" x2="20" y2="18" />
</svg>

<style>
  .hamburger-line-top,
  .hamburger-line-mid,
  .hamburger-line-bot {
    transition: all 300ms ease-in-out;
  }

  :global(.hamburger-open) .hamburger-line-top {
    transform: translateY(6px) rotate(45deg);
  }

  :global(.hamburger-open) .hamburger-line-mid {
    opacity: 0;
  }

  :global(.hamburger-open) .hamburger-line-bot {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
